# Use .\prevclima.ps1 setup to create unique local secrets.
PREVCLIMA_PORT=18080
PUBLIC_BASE_URL=https://your-pc.your-tailnet.ts.net
CORS_ORIGINS=https://your-pc.your-tailnet.ts.net
MYSQL_PASSWORD=GENERATED_BY_SETUP
MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP
JWT_SECRET=GENERATED_BY_SETUP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=CONFIGURE_LOCALLY
SMTP_FROM=you@example.com
INMET_ENABLED=true
INMET_OBSERVATIONS_ENABLED=true
INMET_STATION_CODES=[]
INMET_SYNC_INTERVAL_MINUTES=60
OPEN_METEO_ENABLED=true
