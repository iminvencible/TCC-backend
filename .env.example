APP_ENV=development
PREVCLIMA_PORT=18080
# Use 0.0.0.0 para o aplicativo React Native (../prevclima-app) acessar a API pela rede local.
PREVCLIMA_BIND=0.0.0.0
DATABASE_URL=mysql+pymysql://prevclima:change-me@db:3306/prevclima?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://localhost:8501
# Conta principal do dono (RF03): criada pelo seed com o acesso de meteorologista.
OWNER_NAME=Conta principal
OWNER_EMAIL=
OWNER_PASSWORD=

# E-mail de confirmacao de cadastro e de redefinicao de senha.
# Sem SMTP_HOST, em desenvolvimento, o codigo aparece no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Sincronizacao dos avisos RSS oficiais do INMET ao iniciar e a cada 60 min.
# Nao representa uma API de previsao meteorologica em tempo real.
INMET_ENABLED=true
INMET_WARNING_RSS_URL=https://apiprevmet3.inmet.gov.br/avisos/rss
INMET_TIMEOUT_SECONDS=8
INMET_MAX_RESPONSE_BYTES=2000000
INMET_SYNC_INTERVAL_MINUTES=60
INMET_OBSERVATIONS_ENABLED=true
# Estacoes consultadas pelo worker (lista JSON); vazio evita consultas em massa.
INMET_STATION_CODES=["A001"]

# Previsao atual e diaria sem chave, com armazenamento e fallback local.
OPEN_METEO_ENABLED=true
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_TIMEOUT_SECONDS=8
OPEN_METEO_MAX_RESPONSE_BYTES=1000000
OPEN_METEO_CACHE_MINUTES=15
OPEN_METEO_STALE_HOURS=24

# Mapa do painel dos meteorologistas: chave gratuita em https://cloud.maptiler.com/account/keys/
# (restrinja ao dominio do site). Vazio = usa o OpenFreeMap.
MAPTILER_KEY=
